{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "config": {
      "type": "object",
      "required": ["openwebuiUrl", "mode"],
      "properties": {
        "artifactBaseUrl": {"type": "string"},
        "openwebuiUrl": {"type": "string", "minLength": 1},
        "publicSearchEnabled": {"type": "boolean"},
        "maxConcurrentJobs": {"type": "integer", "minimum": 1, "maximum": 100},
        "mode": {"enum": ["local", "k8s"]},
        "controllerLeaderLockId": {"type": "string", "pattern": "^[0-9]+$"},
        "controllerLeaderRetrySeconds": {"type": "number", "minimum": 0.5},
        "dispatchLeaseSeconds": {"type": "integer", "minimum": 10, "maximum": 3600},
        "dispatchReconcileBatchSize": {"type": "integer", "minimum": 1, "maximum": 10000},
        "eventRetentionDays": {"type": "integer", "minimum": 1, "maximum": 3650},
        "artifactRetentionDays": {"type": "integer", "minimum": 1, "maximum": 3650},
        "jobRetentionDays": {"type": "integer", "minimum": 1, "maximum": 3650},
        "orphanGraceSeconds": {"type": "integer", "minimum": 3600, "maximum": 2592000},
        "cleanupBatchSize": {"type": "integer", "minimum": 1, "maximum": 10000},
        "hardMaxWallTimeSeconds": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    },
    "database": {
      "type": "object",
      "required": ["secretKey"],
      "properties": {
        "existingSecret": {"type": "string"},
        "secretKey": {"type": "string", "minLength": 1}
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "create": {"type": "boolean"},
        "databaseUrl": {"type": "string"},
        "serviceToken": {"type": "string"},
        "signingSecret": {"type": "string"},
        "openwebuiApiKey": {"type": "string"},
        "s3AccessKeyId": {"type": "string"},
        "s3SecretAccessKey": {"type": "string"}
      }
    },
    "functionSync": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0}
      }
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 0}
      }
    }
  },
  "required": ["image", "config", "database", "secrets"]
}
