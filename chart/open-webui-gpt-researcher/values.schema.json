{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "env": {
      "type": "object",
      "required": ["OPENWEBUI_URL", "MODE", "DEFAULT_MODEL_PROFILES"],
      "properties": {
        "ARTIFACT_BASE_URL": {"type": "string"},
        "OPENWEBUI_URL": {"type": "string", "minLength": 1},
        "OPENWEBUI_TIMEOUT_SECONDS": {"type": "number", "minimum": 30, "maximum": 3600},
        "PUBLIC_SEARCH_ENABLED": {"type": "boolean"},
        "RETRIEVER": {"type": "string", "minLength": 1},
        "SCRAPER": {"type": "string", "minLength": 1},
        "SEARX_URL": {"type": "string", "minLength": 1},
        "MAX_CONCURRENT_JOBS": {"type": "integer", "minimum": 1, "maximum": 100},
        "DEFAULT_MODEL_PROFILES": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "required": ["fast", "smart", "strategic"],
                "properties": {
                  "fast": {"type": "string", "minLength": 1},
                  "smart": {"type": "string", "minLength": 1},
                  "strategic": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        },
        "MODEL_CONTEXT_SAFETY_TOKENS": {"type": "integer", "minimum": 0, "maximum": 8192},
        "REASONING_EFFORT": {"enum": ["", "low", "medium", "high"]},
        "MODE": {"enum": ["local", "k8s"]},
        "CONTROLLER_LEADER_LOCK_ID": {"type": "string", "pattern": "^[0-9]+$"},
        "CONTROLLER_LEADER_RETRY_SECONDS": {"type": "number", "minimum": 0.5},
        "DISPATCH_LEASE_SECONDS": {"type": "integer", "minimum": 10, "maximum": 3600},
        "DISPATCH_RECONCILE_BATCH_SIZE": {"type": "integer", "minimum": 1, "maximum": 10000},
        "EVENT_RETENTION_DAYS": {"type": "integer", "minimum": 1, "maximum": 3650},
        "ARTIFACT_RETENTION_DAYS": {"type": "integer", "minimum": 1, "maximum": 3650},
        "JOB_RETENTION_DAYS": {"type": "integer", "minimum": 1, "maximum": 3650},
        "ORPHAN_GRACE_SECONDS": {"type": "integer", "minimum": 3600, "maximum": 2592000},
        "CLEANUP_BATCH_SIZE": {"type": "integer", "minimum": 1, "maximum": 10000},
        "HARD_MAX_WALL_TIME_SECONDS": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    },
    "runner": {
      "type": "object",
      "required": ["activeDeadlineSeconds", "ttlSecondsAfterFinished", "resources"],
      "properties": {
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "extraEnvSecret": {"type": "string"},
        "resources": {"type": "object"}
      }
    },
    "database": {
      "type": "object",
      "required": ["secretKey"],
      "properties": {
        "existingSecret": {"type": "string"},
        "secretKey": {"type": "string", "minLength": 1}
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "create": {"type": "boolean"},
        "databaseUrl": {"type": "string"},
        "serviceToken": {"type": "string"},
        "signingSecret": {"type": "string"},
        "openwebuiApiKey": {"type": "string"},
        "s3AccessKeyId": {"type": "string"},
        "s3SecretAccessKey": {"type": "string"}
      }
    },
    "functionSync": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0}
      }
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 0}
      }
    }
  },
  "required": ["image", "env", "runner", "database", "secrets"]
}
