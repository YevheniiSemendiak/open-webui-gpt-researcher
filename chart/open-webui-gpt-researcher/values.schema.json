{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "applicationImage": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "modelLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_length", "max_output_tokens"],
      "properties": {
        "context_length": {
          "type": "integer",
          "minimum": 4096,
          "description": "Maximum combined input and output context supported by the model."
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum output-token capacity supported by the model."
        }
      }
    },
    "modelsInfo": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/modelLimits"}
    },
    "modelsInfoJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "contentSchema": {"$ref": "#/$defs/modelsInfo"},
      "description": "JSON object mapping exact Open WebUI model IDs to fallback token limits.",
      "examples": [
        "{\"azure/glm-5.2\":{\"context_length\":262144,\"max_output_tokens\":262144}}"
      ]
    },
    "envFrom": {
      "type": "array",
      "items": {"type": "object"}
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "resources": {"type": "object"},
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "objectArray": {
      "type": "array",
      "items": {"type": "object"}
    },
    "companionJob": {
      "type": "object",
      "required": ["enabled", "extraEnv", "backoffLimit", "ttlSecondsAfterFinished", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "extraEnv": {"$ref": "#/$defs/objectArray"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "resources": {"$ref": "#/$defs/resources"}
      }
    },
    "migrationJob": {
      "allOf": [
        {"$ref": "#/$defs/companionJob"},
        {
          "type": "object",
          "required": ["annotations"],
          "properties": {
            "annotations": {"$ref": "#/$defs/stringMap"}
          }
        }
      ]
    }
  },
  "properties": {
    "global": {"type": "object"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "api": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "imagePullSecrets", "service", "serviceAccount", "env", "envFrom", "extraEnv", "resources", "podSecurityContext", "containerSecurityContext", "podLabels", "podAnnotations", "nodeSelector", "tolerations", "affinity", "extraVolumes", "extraVolumeMounts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/$defs/applicationImage"},
        "imagePullSecrets": {"$ref": "#/$defs/objectArray"},
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"},
        "env": {
          "allOf": [{"$ref": "#/$defs/env"}],
          "properties": {
            "MODELS_INFO": {"$ref": "#/$defs/modelsInfoJson"}
          }
        },
        "envFrom": {"$ref": "#/$defs/envFrom"},
        "extraEnv": {"$ref": "#/$defs/objectArray"},
        "resources": {"$ref": "#/$defs/resources"},
        "podSecurityContext": {"type": "object"},
        "containerSecurityContext": {"type": "object"},
        "podLabels": {"$ref": "#/$defs/stringMap"},
        "podAnnotations": {"$ref": "#/$defs/stringMap"},
        "nodeSelector": {"$ref": "#/$defs/stringMap"},
        "tolerations": {"$ref": "#/$defs/objectArray"},
        "affinity": {"type": "object"},
        "extraVolumes": {"$ref": "#/$defs/objectArray"},
        "extraVolumeMounts": {"$ref": "#/$defs/objectArray"}
      }
    },
    "researchJob": {
      "type": "object",
      "required": ["image", "imagePullSecrets", "serviceAccount", "env", "envFrom", "extraEnv", "activeDeadlineSeconds", "ttlSecondsAfterFinished", "backoffLimit", "resources", "podSecurityContext", "containerSecurityContext", "podLabels", "podAnnotations", "nodeSelector", "tolerations", "affinity", "extraVolumes", "extraVolumeMounts"],
      "properties": {
        "image": {"$ref": "#/$defs/applicationImage"},
        "imagePullSecrets": {"$ref": "#/$defs/objectArray"},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"},
        "env": {"$ref": "#/$defs/env"},
        "envFrom": {"$ref": "#/$defs/envFrom"},
        "extraEnv": {"$ref": "#/$defs/objectArray"},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "resources": {"$ref": "#/$defs/resources"},
        "podSecurityContext": {"type": "object"},
        "containerSecurityContext": {"type": "object"},
        "podLabels": {"$ref": "#/$defs/stringMap"},
        "podAnnotations": {"$ref": "#/$defs/stringMap"},
        "nodeSelector": {"$ref": "#/$defs/stringMap"},
        "tolerations": {"$ref": "#/$defs/objectArray"},
        "affinity": {"type": "object"},
        "extraVolumes": {"$ref": "#/$defs/objectArray"},
        "extraVolumeMounts": {"$ref": "#/$defs/objectArray"}
      }
    },
    "migration": {"$ref": "#/$defs/migrationJob"},
    "functionSync": {"$ref": "#/$defs/companionJob"},
    "cleanup": {
      "type": "object",
      "required": ["enabled", "extraEnv", "schedule", "backoffLimit", "ttlSecondsAfterFinished", "successfulJobsHistoryLimit", "failedJobsHistoryLimit", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "extraEnv": {"$ref": "#/$defs/objectArray"},
        "schedule": {"type": "string", "minLength": 1},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "resources": {"$ref": "#/$defs/resources"}
      }
    },
    "searxng": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "imagePullSecrets", "service", "env", "envFrom", "extraEnv", "config", "resources", "podSecurityContext", "containerSecurityContext", "podLabels", "podAnnotations", "nodeSelector", "tolerations", "affinity", "extraVolumes", "extraVolumeMounts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/$defs/image"},
        "imagePullSecrets": {"$ref": "#/$defs/objectArray"},
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "env": {"$ref": "#/$defs/env"},
        "envFrom": {"$ref": "#/$defs/envFrom"},
        "extraEnv": {"$ref": "#/$defs/objectArray"},
        "config": {"type": "string", "minLength": 1},
        "resources": {"$ref": "#/$defs/resources"},
        "podSecurityContext": {"type": "object"},
        "containerSecurityContext": {"type": "object"},
        "podLabels": {"$ref": "#/$defs/stringMap"},
        "podAnnotations": {"$ref": "#/$defs/stringMap"},
        "nodeSelector": {"$ref": "#/$defs/stringMap"},
        "tolerations": {"$ref": "#/$defs/objectArray"},
        "affinity": {"type": "object"},
        "extraVolumes": {"$ref": "#/$defs/objectArray"},
        "extraVolumeMounts": {"$ref": "#/$defs/objectArray"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "additionalIngress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "additionalIngress": {"$ref": "#/$defs/objectArray"}
      }
    }
  },
  "required": ["api", "researchJob", "migration", "functionSync", "cleanup", "searxng", "networkPolicy"]
}
