SERVICE_TOKEN=replace-with-a-long-random-value
SIGNING_SECRET=replace-with-an-independent-long-random-value
OPENWEBUI_API_KEY=
MODE=local
PUBLIC_SEARCH_ENABLED=true
MODEL_ROUTE=openwebui
MODEL_PROFILES={"default":"gpt-4.1-mini"}
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_CONCURRENT_JOBS=5
DISPATCH_LEASE_SECONDS=120
DISPATCH_RECONCILE_BATCH_SIZE=100
EVENT_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=90
JOB_RETENTION_DAYS=90
ORPHAN_GRACE_SECONDS=86400
CLEANUP_BATCH_SIZE=100

# Tavily is GPT Researcher's default public retriever. To run only against selected
# Open WebUI attachments/Knowledge, set PUBLIC_SEARCH_ENABLED=false and
# leave TAVILY_API_KEY empty. RETRIEVER can select another upstream retriever.
RETRIEVER=tavily
TAVILY_API_KEY=

# For MODEL_ROUTE=direct, inject only the chosen provider credentials.
OPENAI_API_KEY=
