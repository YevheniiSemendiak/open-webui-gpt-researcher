SERVICE_TOKEN=replace-with-a-long-random-value
OPENWEBUI_API_KEY=
OPENWEBUI_TIMEOUT_SECONDS=600
MODE=local
PUBLIC_SEARCH_ENABLED=true
DEFAULT_MODEL_PROFILES={"default":{"fast":"gpt-4.1-mini","smart":"gpt-4.1","strategic":"gpt-4.1"}}
DEFAULT_RESEARCH_STRATEGY=balanced
MODEL_CONTEXT_SAFETY_TOKENS=256
# Optional override for reasoning models hidden behind custom OpenWebUI model IDs.
REASONING_EFFORT=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_CONCURRENT_JOBS=5
HARD_MAX_QUERIES=100
RUNNER_HEARTBEAT_SECONDS=10
RUNNER_STALE_SECONDS=60
RUNNER_MAX_ATTEMPTS=2
DISPATCH_LEASE_SECONDS=120
DISPATCH_RECONCILE_BATCH_SIZE=100
EVENT_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=90
JOB_RETENTION_DAYS=90
ORPHAN_GRACE_SECONDS=86400
CLEANUP_BATCH_SIZE=100

# SearXNG discovers URLs; headless NoDriver renders and extracts the pages.
RETRIEVER=searx
SCRAPER=nodriver
SEARX_URL=http://searxng:8080
# Optional Compose overrides. Base mode defaults to dev/searxng/settings.yml;
# proxy mode defaults to the gitignored dev/searxng/settings.local.yml.
SEARXNG_SETTINGS_FILE=
# OPENVPN_CONFIG_DIR and OPENVPN_AUTH_FILE are both required by
# docker-compose.proxy.yaml. The configuration directory is mounted read-only;
# the auth file contains the username on line 1 and password on line 2.
OPENVPN_CONFIG_DIR=
# Optional; defaults to client.ovpn.
OPENVPN_CONFIG_NAME=client.ovpn
OPENVPN_AUTH_FILE=
# Optional direct override when not using docker-compose.proxy.yaml.
CRAWLER_PROXY_URL=
