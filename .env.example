RESEARCH_SERVICE_TOKEN=replace-with-a-long-random-value
RESEARCH_SIGNING_SECRET=replace-with-an-independent-long-random-value
RESEARCH_OPENWEBUI_API_KEY=
RESEARCH_ENGINE=mock
RESEARCH_EXECUTOR=local
RESEARCH_CONTROLLER_LEADER_ELECTION=database
RESEARCH_PUBLIC_SEARCH_ENABLED=true
RESEARCH_MODEL_ROUTE=openwebui
RESEARCH_MODEL_PROFILES={"default":"gpt-4.1-mini"}
RESEARCH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Tavily is GPT Researcher's default public retriever. To run only against selected
# Open WebUI attachments/Knowledge, set RESEARCH_PUBLIC_SEARCH_ENABLED=false and
# leave TAVILY_API_KEY empty. RETRIEVER can select another upstream retriever.
RETRIEVER=tavily
TAVILY_API_KEY=

# For RESEARCH_MODEL_ROUTE=direct, inject only the chosen provider credentials.
OPENAI_API_KEY=
